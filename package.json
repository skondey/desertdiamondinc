{
  "name": "desertdiamondinc-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Desert Diamond Tech - Main consulting site and training academy",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:main": "npm run dev --workspace=apps/main-site",
    "dev:academy": "npm run dev --workspace=apps/academy-site",
    "dev": "npm run dev:main & npm run dev:academy",
    "build:main": "npm run build --workspace=apps/main-site",
    "build:academy": "npm run build --workspace=apps/academy-site",
    "build": "npm run build --workspace=packages/shared && npm run build:main && npm run build:academy",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
